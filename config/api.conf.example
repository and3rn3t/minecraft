# API Server Configuration
# Copy this file to api.conf and set SECRET_KEY — see below for why that
# matters. api/server.py reads this file if present; every value here is
# optional and falls back to the default shown.

# API_HOST=127.0.0.1
# API_PORT=8080
# API_ENABLED=true

# Signs JWTs (login sessions) and Flask's own session cookies. Leaving this
# unset is NOT a safe default: api/server.py generates a random one on every
# process start instead, which silently logs out every user and breaks the
# Logs/Console WebSocket (both accept a JWT) each time the API service
# restarts — including routine updates, reboots, or a crash-restart.
#
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- ALLOWED_ORIGINS is NOT read from this file ---
# CORS is controlled by the ALLOWED_ORIGINS environment variable, not by a
# key in api.conf (api/server.py reads it via os.environ, before this file
# is even parsed). Set it where the API process actually runs -- for the
# systemd deployment, that's an Environment= line for minecraft-api.service.
#
# Don't add it to systemd/minecraft-api.service directly: that file is
# reinstalled from this repo on every `scripts/update-codebase.sh` pull
# (it copies systemd/*.service over whatever's in /etc/systemd/system/), so
# a local edit there is silently lost on the next update. Use an override
# instead, which layers on top and survives that:
#
#   sudo mkdir -p /etc/systemd/system/minecraft-api.service.d
#   sudo tee /etc/systemd/system/minecraft-api.service.d/override.conf <<'EOF'
#   [Service]
#   Environment="ALLOWED_ORIGINS=https://minecraft.yourdomain.com"
#   EOF
#   sudo systemctl daemon-reload
#   sudo systemctl restart minecraft-api.service
#
# (`sudo systemctl edit minecraft-api.service` does the same thing via an
# editor, if you'd rather not paste a heredoc.)
#
# It defaults to "*" (every origin) if unset, which flask-cors combines with
# this API's cookie-based auth (supports_credentials=True) to effectively
# allow any website to make authenticated requests against it. That default
# is fine on a trusted local network; set this explicitly before exposing
# the API beyond one -- the server logs a warning on startup if it's left
# at "*". Comma-separate multiple origins if you need more than one.
