{
  // Python linting here uses the same ruff rules as the pre-commit hook and
  // scripts/lint.sh, so the editor agrees with the gate rather than reporting
  // a different set of problems.
  "ruff.lint.args": ["--select", "F", "--line-length", "120"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests/api"],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}
