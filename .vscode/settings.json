{
  // Ruff's settings are not repeated here. The extension discovers
  // pyproject.toml, which is also what the pre-commit hook and
  // scripts/lint.sh read, so the editor cannot disagree with the gate.
  //
  // "ruff.lint.args" used to carry them, and the native server that replaced
  // ruff-lsp does not support it — see
  // https://docs.astral.sh/ruff/editors/migration/
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests/api"],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}
